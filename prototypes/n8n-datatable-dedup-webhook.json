      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = $json.body ?? $json;\nconst clean = v => String(v ?? '').trim().replace(/\\s+/g, ' ');\nconst eventId = clean(raw.event_id);\nconst email = clean(raw.email).toLowerCase();\nconst phoneRaw = clean(raw.phone);\nconst digits = phoneRaw.replace(/\\D/g, '');\nconst phone = phoneRaw ? (phoneRaw.startsWith('+') ? '+' + digits : digits) : '';\nif (!eventId) throw new Error('missing_event_id');\nif (!email && !phone) throw new Error('missing_identity');\nconst identityKey = email ? `email:${email}` : `phone:${phone}`;\nreturn [{json:{eventKey:`event:${eventId}`, identityKey, recordId:`lead:${eventId}`}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 0],
      "id": "dt-normalize",
      "name": "Normalize Keys"
    },
